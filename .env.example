# Kestrel Routing Intelligence — example environment file
#
# This project requires NO API keys and NO external LLM credentials: the
# routing model is fully local (see MODEL_CARD.md "Cost considerations").
# The variables below are optional runtime configuration only.

# Port for `uvicorn app.api:app --port $API_PORT`
API_PORT=8000

# Port for `streamlit run app/ui.py --server.port $STREAMLIT_PORT`
STREAMLIT_PORT=8501

# Optional: only used if you enable the commented-out sentence-transformers
# line in requirements.txt for semantic historical-similarity retrieval
# (src/retrieval.py falls back to TF-IDF automatically if this is unset or
# the package/model is unavailable). Points to a local cache directory so
# the model isn't re-downloaded on every run.
# HF_HOME=./.cache/huggingface

# Optional: disable Streamlit's anonymous usage-statistics prompt in CI/headless runs.
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
